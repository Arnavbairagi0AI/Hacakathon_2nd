# VentureSetu — Firebase Web App configuration (client-side, public by design).
# Fill these from: Firebase console -> Project settings -> General -> Your apps
# -> Web app -> SDK setup and configuration. NEVER put service-account keys here.
# Copy this file to .env and restart `npm run dev`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# LOCAL DEV / E2E ONLY — set to 1 to route all SDK calls to the local
# emulators (`npm run emulators`). NEVER set this on a deployed build.
# VITE_USE_EMULATORS=1
